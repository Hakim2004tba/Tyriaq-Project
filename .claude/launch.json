    {
      "name": "art-cuisine",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "art-cuisine/node_modules/next/dist/bin/next",
        "dev",
        "art-cuisine"
      ],
      "port": 3210,
      "autoPort": true
    },
    {
      "name": "nb-sport",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "nb-sport/node_modules/next/dist/bin/next",
        "dev",
        "nb-sport"
      ],
      "port": 3220,
      "autoPort": true
    }
  ]
