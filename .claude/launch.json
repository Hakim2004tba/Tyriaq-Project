{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "apps/web/node_modules/next/dist/bin/next",
        "dev",
        "apps/web"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "tibyan",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/dev-tibyan.mjs",
        "3100"
      ],
      "port": 3100,
      "autoPort": true
    },
    {
      "name": "tyriaq-club-site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "--directory",
