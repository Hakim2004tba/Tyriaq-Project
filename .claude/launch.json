      "port": 4173
    },
    {
      "name": "tibyan-prod",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/start-tibyan-prod.mjs",
        "3101"
      ],
      "port": 3101,
      "autoPort": true
    },
    {
      "name": "tyriaq-website",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "tyriaq-website/server.mjs",
        "4200"
      ],
      "port": 4200
