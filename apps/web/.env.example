# Tyriaq — copy to .env.local and fill in from your Supabase project's
# API settings. Both values are public: the anon key is meant to ship to
# the browser, and Row Level Security is what actually protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. Only needed when the origin cannot be inferred from the
# request — for example behind a proxy, or in preview deployments where
# the emailed links must point at a fixed domain.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
